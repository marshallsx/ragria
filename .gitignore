# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Python virtual environment ---
venv/

# --- Source documents ---
# Raw PDFs are large and not needed at runtime — kept out of git.
data/raw/
# The page caches (per version) are only used to re-chunk; not needed at runtime.
data/interim/slc_pages*.jsonl
# NOTE: data/interim/slc_chunks.jsonl (public Ofgem text, ~1.6MB) IS committed —
# the deployed app's BM25 index needs it. It is intentionally not ignored here.

# --- ChromaDB vector store ---
# The prebuilt store IS committed (bundled for deployment) — it's derived from
# public Ofgem data. Only ignore stray/alternate stores.
*.chroma
chroma_store/

# --- Eval run artefacts (derived; not committed) ---
# A/B run log + the resumable bge embedding checkpoint (regenerated by evals/embedder_ab.py).
evals/embedder_ab.log
data/interim/bge_ab_ckpt/

# --- Python caches / build artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
.vscode/
.idea/
